# OneDrive / Microsoft Graph Configuration
MICROSOFT_GRAPH_API_ENDPOINT=https://graph.microsoft.com/v1.0
ONEDRIVE_CLIENT_ID=your_client_id_here
ONEDRIVE_CLIENT_SECRET=your_client_secret_here
