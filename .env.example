# OneDrive / Microsoft Graph Configuration (Optional - leave empty for demo mode)
MICROSOFT_GRAPH_API_ENDPOINT=https://graph.microsoft.com/v1.0
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_FOLDER_ID=

# Refresh interval (milliseconds)
PDF_POLLING_INTERVAL=60000
INACTIVITY_REFRESH_TIME=300000

# Demo Mode
# When OneDrive credentials are not set, the app loads pdf-reports/usefulness-study_report_nxw7mthavmev.pdf
# To enable OneDrive, fill in the credentials above and set DEMO_MODE=false
